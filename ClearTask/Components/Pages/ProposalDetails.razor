  <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true">
    <!-- Вкладка "Заявка" -->
    <MudTabPanel Text="Заявка">
        <button class="btn btn-secondary mb-3" @onclick="GoBack">Вернуться</button>
    </MudTabPanel>

    <!-- Вкладка "Материалы" -->
    <MudTabPanel Text="Материалы">
        <button class="btn btn-primary mb-3" @onclick="OpenCreateMaterialForm">Создать материал</button>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Наименование</th>
                    <th>Код</th>
                    <th>Количество</th>
                    <th>Комментарий</th>
                    @if (proposal.Status == ProposalStatus.Created)
                    {
                        <th>Действия</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (proposal.Materials.Any(m => m.Status != MaterialStatus.Deleted))
                {
                    @foreach (var material in proposal.Materials.Where(m => m.Status != MaterialStatus.Deleted))
                    {
                        <tr>
                            <td>@material.Name</td>
                            <td>@material.Code</td>
                            <td>@material.Quantity</td>
                            <td>@material.Comment</td>
                            @if (proposal.Status == ProposalStatus.Created)
                            {
                                <td>
                                    <button class="btn btn-primary btn-sm" @onclick="() => OpenEditMaterialForm(material)">Редактировать</button>
                                    <button class="btn btn-danger btn-sm" @onclick="() => OpenDeleteMaterialConfirmation(material)">Удалить</button>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(proposal.Status == ProposalStatus.Created ? 5 : 4)" class="text-center">Материалы отсутствуют.</td>
                    </tr>
                }
            </tbody>
        </table>
    </MudTabPanel>
</MudTabs>

    <!-- Модальное окно редактирования заявки -->
    <Modal @bind-Visible="editFormIsOpened">
        <ModalHeader>Редактирование заявки</ModalHeader>
        <ModalBody>
            @if (editingProposal != null)
            {
                <EditForm Model="@editingProposal" OnValidSubmit="SaveEditedProposal">
                    <DataAnnotationsValidator />
                    <Blazorise.ValidationSummary />
                    <InputText @bind-Value="editingProposal.Author" Placeholder="Автор" />
                    <InputText @bind-Value="editingProposal.Division" Placeholder="Подразделение" />
                    <button type="submit" class="btn btn-primary mt-3">Сохранить</button>
                </EditForm>
            }
            else
            {
                <p>Ошибка: Заявка не инициализирована.</p>
            }
        </ModalBody>
        <ModalFooter>
            <button class="btn btn-secondary" @onclick="CloseEditForm">Закрыть</button>
        </ModalFooter>
    </Modal>

    <!-- Модальное окно подтверждения утверждения -->
    <Modal @bind-Visible="approveConfirmationIsOpened">
        <ModalBody>Вы уверены, что хотите утвердить текущую заявку?</ModalBody>
        <ModalFooter>
            <button class="btn btn-success" @onclick="ConfirmApprove">Да</button>
            <button class="btn btn-secondary" @onclick="CancelApprove">Нет</button>
        </ModalFooter>
    </Modal>

    <!-- Модальное окно подтверждения удаления -->
    <Modal @bind-Visible="deleteConfirmationIsOpened">
        <ModalBody>Вы уверены, что хотите удалить заявку №@proposal.FullNumber?</ModalBody>
        <ModalFooter>
            <button class="btn btn-danger" @onclick="ConfirmDelete">Да</button>
            <button class="btn btn-secondary" @onclick="CancelDelete">Нет</button>
        </ModalFooter>
    </Modal>

    <!-- Модальное окно подтверждения удаления -->
    <Modal @bind-Visible="deleteMaterialConfirmationIsOpened">
        <ModalBody>Вы уверены, что хотите удалить Материал @newMaterial.Name?</ModalBody>
        <ModalFooter>
            <button class="btn btn-danger" @onclick="ConfirmDeleteMaterial">Да</button>
            <button class="btn btn-secondary" @onclick="CancelDelete">Нет</button>
        </ModalFooter>
    </Modal>

    <!-- Модальное окно создания материала -->
    <Modal @bind-Visible="createMaterialFormIsOpened">
        <ModalHeader>Создание материала</ModalHeader>
        <ModalBody>
            @if (newMaterial != null)
            {
                <EditForm Model="@newMaterial" OnValidSubmit="SaveNewMaterial">
                    <DataAnnotationsValidator />
                    <Blazorise.ValidationSummary />
                    <InputText @bind-Value="newMaterial.Name" Placeholder="Наименование" />
                    <InputText @bind-Value="newMaterial.Code" MaxLength="10" Placeholder="Код (макс. 10 символов)" />
                    <InputNumber @bind-Value="newMaterial.Quantity" Min="1" Placeholder="Количество (мин. 1)" />
                    <InputText @bind-Value="newMaterial.Comment" Placeholder="Комментарий" />
                    <button type="submit" class="btn btn-primary mt-3">Сохранить</button>
                </EditForm>
            }
            else
            {
                <p>Ошибка: Материал не инициализирован.</p>
            }
        </ModalBody>
        <ModalFooter>
            <button class="btn btn-secondary" @onclick="CloseCreateMaterialForm">Закрыть</button>
        </ModalFooter>
    </Modal>

    <!-- Модальное окно редактирования материала -->
    <Modal @bind-Visible="editMaterialFormIsOpened">
        <ModalHeader>Редактирование материала</ModalHeader>
        <ModalBody>
            @if (editingMaterial != null)
            {
                <EditForm Model="@editingMaterial" OnValidSubmit="SaveEditedMaterial">
                    <DataAnnotationsValidator />
                    <Blazorise.ValidationSummary />
                    <InputText @bind-Value="editingMaterial.Name" Placeholder="Наименование" />
                    <InputText @bind-Value="editingMaterial.Code" MaxLength="10" Placeholder="Код (макс. 10 символов)" />
                    <InputNumber @bind-Value="editingMaterial.Quantity" Min="1" Placeholder="Количество (мин. 1)" />
                    <InputText @bind-Value="editingMaterial.Comment" Placeholder="Комментарий" />
                    <button type="submit" class="btn btn-primary mt-3">Сохранить</button>
                </EditForm>
            }
            else
            {
                <p>Ошибка: Материал не инициализирован.</p>
            }
        </ModalBody>
        <ModalFooter>
            <button class="btn btn-secondary" @onclick="CloseEditMaterialForm">Закрыть</button>
        </ModalFooter>
    </Modal>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Proposal proposal;
    private Proposal editingProposal = new();
    private bool editFormIsOpened = false;
    private bool approveConfirmationIsOpened = false;
    private bool deleteConfirmationIsOpened = false;
    private bool deleteMaterialConfirmationIsOpened = false;

    private ProposalMaterial newMaterial = new();
    private bool createMaterialFormIsOpened = false;

    private ProposalMaterial editingMaterial = new();
    private bool editMaterialFormIsOpened = false;
    private int selectedTab = 0;

        private void OnSelectedTabChanged(int newTab)
    {
        selectedTab = newTab;
    }

    protected override async Task OnParametersSetAsync()
    {
        proposal = await ProposalService.GetProposalById(Id);
        if (proposal != null)
        {
            editingProposal = proposal.Clone();
            StateHasChanged(); // Принудительно обновить UI
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/proposals");
    }

    private void OpenEditForm()
    {
        editingProposal = proposal.Clone() ?? new Proposal();
        editFormIsOpened = true;
    }

    private async Task SaveEditedProposal()
    {
        if (editingProposal != null)
        {
            await ProposalService.UpdateProposal(editingProposal);
            proposal = await ProposalService.GetProposalById(Id);
            editFormIsOpened = false;
        }
    }

    private void CloseEditForm()
    {
        editFormIsOpened = false;
    }

    private void OpenApproveConfirmation()
    {
        approveConfirmationIsOpened = true;
    }

    private async Task ConfirmApprove()
    {
        if (proposal != null)
        {
            proposal.Status = ProposalStatus.Approved;
            await ProposalService.UpdateProposal(proposal);
            StateHasChanged();
        }
        approveConfirmationIsOpened = false;
    }

    private void CancelApprove()
    {
        approveConfirmationIsOpened = false;
    }

    private void OpenDeleteConfirmation()
    {
        deleteConfirmationIsOpened = true;
    }

    private void OpenDeleteMaterialConfirmation()
    {
        deleteMaterialConfirmationIsOpened = true;
    }

   

    private async Task ConfirmDelete()
    {
        if (proposal != null)
        {
            proposal.Status = ProposalStatus.Deleted;
            await ProposalService.UpdateProposal(proposal);
            StateHasChanged();
            NavManager.NavigateTo("/proposals");
        }
        deleteConfirmationIsOpened = false;
    }

    private async Task ConfirmDeleteMaterial()
    {
        if (editingMaterial != null)
        {
            try
            {
                Console.WriteLine($"Удаление материала: {editingMaterial.Name}");
                editingMaterial.Status = MaterialStatus.Deleted;

                await ProposalService.DeleteProposalMaterial(editingMaterial);

                // Обновляем данные заявки
                proposal = await ProposalService.GetProposalById(Id);
                StateHasChanged(); // Обновляем UI
                Console.WriteLine($"Материал успешно удалён.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Ошибка при удалении материала: {ex.Message}");
            }
        }
        deleteMaterialConfirmationIsOpened = false; // Закрываем модальное окно
    }

    // private async Task ConfirmDelete()
    // {
    //     if (proposal != null)
    //     {
    //         await ProposalService.DeleteProposal(proposal.Id);
    //         NavManager.NavigateTo("/proposals");
    //     }
    //     deleteConfirmationIsOpened = false;
    // }

    private void CancelDelete()
    {
        deleteConfirmationIsOpened = false;
    }

    private void CancelDeleteMaterial()
    {
        deleteMaterialConfirmationIsOpened = false;
    }

    private void OpenCreateMaterialForm()
    {
        newMaterial = new ProposalMaterial { ProposalId = Id };
        createMaterialFormIsOpened = true;
    }

    private async Task SaveNewProposalMaterial()
    {
        if (newMaterial != null)
        {
            await ProposalService.CreateProposalMaterial(newMaterial);
            proposal = await ProposalService.GetProposalById(Id);
            createMaterialFormIsOpened = false;
        }
    }

    private void CloseCreateMaterialForm()
    {
        createMaterialFormIsOpened = false;
    }

    private void OpenEditMaterialForm(ProposalMaterial material)
    {
        editingMaterial = material.Clone() ?? new ProposalMaterial();
        editMaterialFormIsOpened = true;
    }

    private async Task SaveEditedMaterial()
    {
        if (editingMaterial != null)
        {
            await ProposalService.UpdateProposalMaterial(editingMaterial);
            proposal = await ProposalService.GetProposalById(Id);
            editMaterialFormIsOpened = false;
        }
    }

    private void CloseEditMaterialForm()
    {
        editMaterialFormIsOpened = false;
    }

    private void OpenDeleteMaterialConfirmation(ProposalMaterial material)
    {
        editingMaterial = material;
        deleteMaterialConfirmationIsOpened = true;
    }
    private async Task SaveNewMaterial()
    {
        if (newMaterial != null)
        {
            await ProposalService.CreateProposalMaterial(newMaterial);
            proposal = await ProposalService.GetProposalById(Id);
            createMaterialFormIsOpened = false;
        }
    }
}